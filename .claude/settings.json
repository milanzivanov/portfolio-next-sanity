{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{try{const o=JSON.parse(d);const f=(o.tool_input&&o.tool_input.file_path)||'';if(/\\.(ts|tsx)$/.test(f)){require('child_process').execFileSync('pnpm',['exec','eslint','--fix',f],{stdio:'inherit',shell:true});}}catch(e){}})\"",
            "timeout": 30,
            "statusMessage": "Linting changed file..."
          }
        ]
      }
    ]
  }
}
